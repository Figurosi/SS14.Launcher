{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Figurosi/SS14.Launcher/master/Documentation/marsey.schema.json",
  "title": "Marsey mod manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "version",
    "apiVersion",
    "entryAssembly",
    "entryType"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+(?:\\.[0-9]+){1,3}$"
    },
    "apiVersion": {
      "type": "integer",
      "minimum": 1
    },
    "entryAssembly": {
      "type": "string",
      "minLength": 5,
      "maxLength": 255,
      "pattern": "^[^/\\\\:]+\\.[dD][lL][lL]$"
    },
    "entryType": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "minimumLauncherVersion": {
      "type": "string",
      "pattern": "^[0-9]+(?:\\.[0-9]+){1,3}$"
    },
    "maximumLauncherVersionExclusive": {
      "type": "string",
      "pattern": "^[0-9]+(?:\\.[0-9]+){1,3}$"
    },
    "loadPhase": {
      "type": "string",
      "enum": [
        "BeforeContentAssemblies",
        "AfterContentAssemblies",
        "AfterClientStartup"
      ]
    },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 128,
        "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
      }
    },
    "conflicts": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 128,
        "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
      }
    }
  }
}
